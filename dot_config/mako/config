# Colors
background-color=#282828
text-color=#ebdbb2
border-color=#1d2021
progress-color=#1d2021

# Sizing
font=Overpass: 15
border-radius=0
padding=15
height=175
width=500
max-icon-size=128
border-size=4
# Misc
default-timeout=7000
anchor=top-right
layer=top
icon-path=/usr/share/icons/Catppuccin-SE

# Action menu
on-button-left=exec makoctl menu -n "$id" rofi -dmenu -p 'Select action: ' && makoctl dismiss -n "$id"
# Formatting
format=<span color='#928374' size='smaller' style='italic'>%a</span>\n<span size='larger' weight='bold'>%s</span>\n%b

[app-name=""]
format=<span color='#928374' size='smaller' style='italic'>unkown</span>\n<span size='larger' weight='bold'>%s</span>\n%b

[actionable]
format=<span color='#928374' size='smaller' style='italic'>%a</span>\n<span color='#cc241d' size='smaller' weight='bold'>(A) </span><span size='larger' weight='bold'>%s</span>\n%b

[actionable app-name=""]
format=<span color='#928374' size='smaller' style='italic'>unkown</span>\n<span color='#cc241d' size='smaller' weight='bold'>(A) </span><span size='larger' weight='bold'>%s</span>\n%b

[urgency=high]
border-color=#b16286
default-timeout=0

[app-name="sway"]
anchor=top-center
layer=overlay
text-alignment=center
format=<b>%s: %b</b>

[category="volume"]
border-color=#689d6a
text-color=#689d6a

[category="volume-muted"]
border-color=#928374
text-color=#928374

[category="backlight"]
border-color=#458688
text-color=#458688

