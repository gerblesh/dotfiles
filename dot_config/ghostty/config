command = /bin/fish
auto-update-channel = tip
theme = GruvboxDark
font-size = 13

background-opacity = 0.9


cursor-style-blink = false
shell-integration = fish
shell-integration-features = no-cursor
cursor-style = underline
cursor-style-blink = false


gtk-custom-css = ?style.css
window-decoration = false
gtk-titlebar = true
gtk-single-instance = true
gtk-adwaita = true
gtk-wide-tabs = false
# adw-toolbar-style = flat
gtk-tabs-location = bottom

# Split/window management
# keybind = alt+w=new_split:down
keybind = alt+w=new_split:auto
keybind = alt+q=close_window
keybind = alt+t=new_tab

# Split navigation
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Resize Splits
keybind = shift+alt+h=resize_split:left,10
keybind = shift+alt+j=resize_split:down,10
keybind = shift+alt+k=resize_split:up,10
keybind = shift+alt+l=resize_split:right,10
keybind = alt+z=toggle_split_zoom

window-theme = ghostty

font-family = SF Mono

# FIXME: temp (until more programs support ghostty terminfo)!
term = kitty
