        //    "signal": "󰆉",
        //    "librewolf": "󰈹",
        //    "firefox": "󰈹",
        //    "zen": "󰈹",
        //    "de.haeckerfelix.fragments": "󱑣",
        //    "steamwebhelper": "󰓓",
        //    "dolphin-emu": "󱢴",
        //    "yuzu": "󰟡",
        //    "info.cemu.cemu": "󰜭",
        //    "otpclient": "󰥿",
        //    "com.github.tchx84.flatseal": "",
        //    "com.github.gradienceteam.gradience.devel": "",
        //    "io.github.flattool.warehouse": "",
        //    "io.missioncenter.missioncenter": "󰨇",
        //    "gnome-boxes": "󰹑",
        //    "blender": "󰂫",
