command = /bin/fish
auto-update-channel = tip
theme = GruvboxDark
font-size = 16

background-opacity = 0.9
# cursor-opacity = 0.94

cursor-style-blink = false
shell-integration = fish
shell-integration-features = no-cursor
cursor-style = underline
cursor-style-blink = false

# GTK shiz
window-decoration = false
gtk-titlebar = true
gtk-single-instance = true
gtk-adwaita = true
adw-toolbar-style = flat
gtk-tabs-location = bottom

# Split/window management
keybind = alt+w=new_split:down
keybind = alt+v=new_split:right
keybind = alt+q=close_window
keybind = alt+t=new_tab
keybind = shift+alt+n=new_window
keybind = ctrl+alt+n=new_window

# Split navigation
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right

# Resize Splits
keybind = shift+alt+h=resize_split:left,10
keybind = shift+alt+j=resize_split:down,10
keybind = shift+alt+k=resize_split:up,10
keybind = shift+alt+l=resize_split:right,10
keybind = alt+z=toggle_split_zoom
theme = GruvboxDark

window-theme = ghostty


font-family = SF Mono

# FIXME: temp (until more programs support ghostty terminfo)!
term = kitty
