# Colors
background-color=#161616
text-color=#f2f4f8
border-color=#484848
progress-color=#484848

# Sizing
font=Overpass: 15
border-radius=0
padding=15
height=175
width=500
max-icon-size=128
border-size=4
# Misc
default-timeout=7000
anchor=top-right
layer=top
icon-path=/usr/share/icons/Catppuccin-SE

# Action menu
on-button-left=exec makoctl menu -n "$id" rofi -dmenu -p 'Select action: ' && makoctl dismiss -n "$id"
# Formatting
format=<span color='#484848' size='smaller' style='italic'>%a</span>\n<span size='larger' weight='bold'>%s</span>\n%b

[app-name=""]
format=<span color='#484848' size='smaller' style='italic'>unkown</span>\n<span size='larger' weight='bold'>%s</span>\n%b

[actionable]
format=<span color='#484848' size='smaller' style='italic'>%a</span>\n<span color='#ee5396' size='smaller' weight='bold'>(A) </span><span size='larger' weight='bold'>%s</span>\n%b

[actionable app-name=""]
format=<span color='#484848' size='smaller' style='italic'>unkown</span>\n<span color='#ee5396' size='smaller' weight='bold'>(A) </span><span size='larger' weight='bold'>%s</span>\n%b

[urgency=high]
border-color=#ee5396
default-timeout=0

[app-name="sway"]
anchor=top-center
layer=overlay
text-alignment=center
format=<b>%s: %b</b>

[category="volume"]
border-color=#33b1ff
text-color=#33b1ff

[category="volume-muted"]
border-color=#484848
text-color=#484848

[category="backlight"]
border-color=#be95ff
text-color=#be95ff

